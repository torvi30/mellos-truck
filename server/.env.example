# ===============================================
# MELLOS TRUCK S.A.S. - BACKEND ENVIRONMENT CONFIG
# ===============================================

PORT=4000
NODE_ENV=production

# Base de Datos MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_secure_password
DB_NAME=mellos_truck_db
DB_PORT=3306

# Seguridad JWT
JWT_SECRET=super_secret_jwt_key_mellos_truck_2026_production

# Bot de Telegram para Notificaciones de Taller en Tiempo Real
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_group_or_channel_chat_id

# URL del Cliente Web Frontend (para enlaces de WhatsApp / Showroom)
CLIENT_URL=https://mellos-trucks.com
