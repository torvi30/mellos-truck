rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // ============================================================
    // REGLAS STORAGE - MELLOS TRUCK (Subida de fotos y videos)
    // ============================================================

    // Lectura pública de imágenes de galería y showroom
    match /{allPaths=**} {
      allow read: if true;
      allow write: if true; // En producción: request.auth != null
    }
  }
}
