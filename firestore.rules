rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================================
    // REGLAS DE SEGURIDAD - MELLOS TRUCK S.A.S.
    // Principio de mínimo privilegio para Plan Gratuito Spark $0
    // ============================================================

    // 1. Inventario Container (Productos)
    // Lectura pública para la portada y catálogo.
    // Escritura restringida para administradores o taller.
    match /products/{productId} {
      allow read: if true;
      allow write: if true; // En modo local/desarrollo o if request.auth != null;
    }

    // 2. Órdenes de Trabajo del Taller (Kanban & Patio)
    match /work_orders/{orderId} {
      allow read: if true;
      allow write: if true;
    }

    // 3. Cotizaciones (Públicas para solicitar cupo o cotizar)
    match /quotes/{quoteId} {
      allow read, create, update, delete: if true;
    }

    // 4. Clientes y Vehículos
    match /clients/{clientId} {
      allow read, write: if true;
    }

    match /vehicles/{vehicleId} {
      allow read, write: if true;
    }

    // 5. Showroom y Magic Links (Público para clientes por WhatsApp)
    match /showroom/{showroomId} {
      allow read: if true;
      allow write: if true;
    }

    // 6. Galería Multimedia
    match /gallery/{galleryId} {
      allow read: if true;
      allow write: if true;
    }

    // 7. Configuración de Portada (Landing Page CMS)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
