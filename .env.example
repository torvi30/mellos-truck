# Variables para Backend (Express / MySQL / Telegram)
PORT=4000
NODE_ENV=production
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_secure_password
DB_NAME=mellos_truck_db
DB_PORT=3306
JWT_SECRET=super_secret_jwt_key_mellos_truck_2026_production
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_group_or_channel_chat_id
